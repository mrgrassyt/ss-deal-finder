# Copy to .env (setup.sh does this for you)
DOMAIN=203-0-113-5.sslip.io
SSDEAL_PASSWORD=choose-a-long-password
TZ=Europe/Riga
# Name of the first (admin) account; it uses SSDEAL_PASSWORD as its password the first time and takes over any data already on the server.
SSDEAL_ADMIN_USER=admin
# Optional: the portfolio site (portfolio/) on its own domain; DOMAIN above then holds the deal finder, e.g. SITE_DOMAIN=mrgrass.me, DOMAIN=deals.mrgrass.me
#SITE_DOMAIN=mrgrass.me
# Optional: a separate password for the portfolio dashboard (https://SITE_DOMAIN/admin). Without it the dashboard starts with SSDEAL_PASSWORD; change it in the dashboard.
#SITE_ADMIN_PASSWORD=
# Optional: forward contact-form messages by email (they always arrive in the dashboard under Messages).
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASSWORD=
#SITE_MAIL_TO=
