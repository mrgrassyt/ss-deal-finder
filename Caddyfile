# The portfolio on SITE_DOMAIN (e.g. mrgrass.me), the deal finder on DOMAIN (e.g. deals.mrgrass.me). Automatic HTTPS for both.
{$SITE_DOMAIN:site.localhost} {
	encode zstd gzip
	reverse_proxy site:8770
}
www.{$SITE_DOMAIN:site.localhost} {
	redir https://{$SITE_DOMAIN:site.localhost}{uri} permanent
}
{$DOMAIN} {
	encode gzip
	reverse_proxy app:8765
}
